{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeepay.local/schemas/yilaiqian-checkout-page-spec-v1.json",
  "title": "Yilaiqian Checkout Page Spec",
  "type": "object",
  "required": ["schemaVersion", "metadata", "ui", "content", "checkout"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "metadata": { "type": "object" },
    "ui": { "type": "object" },
    "content": { "type": "object" },
    "checkout": {
      "type": "object",
      "properties": {
        "resultOutcome": { "enum": ["success", "failure"] },
        "failure": {
          "type": "object",
          "properties": { "reason": { "type": "string" }, "action": { "type": "string" } }
        }
      }
    },
    "states": { "type": "object" }
  }
}
