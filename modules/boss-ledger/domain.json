{
  "version": 1,
  "module": "boss-ledger",
  "implementationMode": "markdown-spec-shell",
  "adapter": {
    "execution": {
      "policy": "modules/boss-ledger/execution/generation-policy.json",
      "schema": "modules/boss-ledger/execution/page-spec.schema.json",
      "releaseManifest": "modules/boss-ledger/execution/release-manifest.json",
      "coreContext": "modules/boss-ledger/execution/context-packs/core.md",
      "familyContexts": {
        "list": "modules/boss-ledger/execution/context-packs/list.md",
        "form": "modules/boss-ledger/execution/context-packs/form.md",
        "detail": "modules/boss-ledger/execution/context-packs/detail.md",
        "result": "modules/boss-ledger/execution/context-packs/result.md"
      },
      "scaffoldCommand": "node scripts/scaffold-boss-ledger-page-spec.mjs changes/{change-id}",
      "buildCommand": "node scripts/build-boss-ledger-page-spec.mjs changes/{change-id}/page-spec.json",
      "verifyCommand": "node scripts/verify-boss-ledger-page-spec.mjs changes/{change-id}/page-spec.json"
    },
    "resources": {
      "requirement": ["modules/shared/product.md", "modules/boss-ledger/business-rules.md"],
      "design": ["modules/shared/design-system.md", "modules/boss-ledger/design.md", "modules/shared/page-templates.md", "modules/shared/components.md"],
      "template": ["modules/shared/template-routing.md"],
      "generate": ["modules/shared/frontend.md", "modules/shared/quality.md"],
      "review": ["modules/boss-ledger/business-rules.md", "modules/boss-ledger/design.md", "modules/shared/quality.md"]
    },
    "template": {
      "directory": "modules/boss-ledger/templates",
      "stages": ["template", "generate", "review"],
      "framework": ["template-01-framework-shell.md"],
      "supportingRules": [
        {
          "signals": ["wizard", "分步", "步骤", "新增标签页"],
          "templates": ["template-10-wizard.md"]
        }
      ]
    },
    "commands": {
      "generate": {
        "preflight": "node scripts/read-boss-ledger-rules.mjs changes/{change-id} {templates}",
        "scaffold": "node scripts/scaffold-boss-ledger-preview.mjs changes/{change-id}"
      }
    }
  },
  "intents": [
    {"id":"query-list","pageType":"query-list","executionFamily":"list","signals":["查询列表","审核列表","配置列表","查询","列表","记录","台账"],"template":"template-03-query-list-regular.md"},
    {"id":"inline-summary-list","pageType":"query-list-inline-summary","executionFamily":"list","signals":["轻量汇总","行内统计","不超过3个指标","2个指标","3个指标"],"template":"template-04-query-list-inline-summary.md"},
    {"id":"card-summary-list","pageType":"query-list-card-summary","executionFamily":"list","signals":["卡片汇总","超过3个指标","多指标统计"],"template":"template-05-query-list-card-summary.md"},
    {"id":"dashboard","pageType":"dashboard","executionFamily":"dashboard","signals":["dashboard","仪表盘","数据首页","经营概览","数据大盘"],"template":"template-02-dashboard-home.md"},
    {"id":"modal-form","pageType":"modal-form","executionFamily":"form","signals":["modal","弹窗表单","弹窗新增","弹窗编辑"],"template":"template-06-modal-form.md"},
    {"id":"drawer-form","pageType":"drawer-form","executionFamily":"form","signals":["drawer 表单","抽屉表单","抽屉新增","抽屉编辑"],"template":"template-07-drawer-form.md"},
    {"id":"full-page-form","pageType":"full-page-form","executionFamily":"form","signals":["全页表单","新建页","编辑页","新增页"],"template":"template-08-full-page-form.md"},
    {"id":"guided-form","pageType":"guided-form","executionFamily":"form","signals":["右侧说明","操作提示","说明表单","引导表单"],"template":"template-13-guided-form.md"},
    {"id":"detail","pageType":"detail","executionFamily":"detail","signals":["详情页","抽屉详情","详情"],"template":"template-09-drawer-detail.md"},
    {"id":"wizard","pageType":"wizard","executionFamily":"form","signals":["wizard","步骤页","分步流程","步骤条"],"template":"template-10-wizard.md"},
    {"id":"result","pageType":"result","executionFamily":"result","signals":["result","结果页","成功页","失败页"],"template":"template-11-result.md"},
    {"id":"empty-state","pageType":"empty-state","executionFamily":"empty-state","signals":["empty state","空状态","空页"],"template":"template-12-empty-state.md"}
  ]
}
