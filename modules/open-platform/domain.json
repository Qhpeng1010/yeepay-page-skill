{
  "version": 1,
  "module": "open-platform",
  "implementationMode": "markdown-direct",
  "adapter": {
    "resources": {
      "requirement": ["modules/shared/product.md"],
      "design": ["modules/shared/design-system.md", "modules/open-platform/theme.md", "modules/shared/page-templates.md", "modules/shared/components.md"],
      "template": [],
      "generate": ["modules/shared/frontend.md", "modules/shared/quality.md", "modules/shared/templates/html-preview.md"],
      "review": ["modules/open-platform/theme.md", "modules/shared/quality.md"]
    },
    "commands": {}
  },
  "intents": [
    {"id":"product-home","pageType":"product-home","signals":["产品首页","开放平台首页","产品介绍","产品中心"]},
    {"id":"api-document","pageType":"api-document","signals":["api 文档","接口文档","接口详情","请求参数","请求示例"]},
    {"id":"sdk-document","pageType":"sdk-document","signals":["sdk 文档","sdk","下载 sdk"]},
    {"id":"error-code","pageType":"error-code","signals":["错误码","异常码","报错说明"]},
    {"id":"integration-guide","pageType":"integration-guide","signals":["接入指南","接入流程","快速开始","对接指南"]}
  ]
}
